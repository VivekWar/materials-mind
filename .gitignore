# Environment files (secrets must never be committed)
.env
.env.local
.env.development.local
.env.test.local
# .env.production is intentionally tracked — it contains only PUBLIC values
# (API URL + Google client ID). Actual secrets go into CI/CD environment vars.
!.env.production

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
build/
coverage/
backend/dist/
frontend/dist/
frontend/build/

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Python caches and artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Go artifacts
*.exe
*.test
*.out

# Temporary files
*.tmp
*.temp
*.pid
*.pid.lock
*.seed.gitignore
backend/materialmind
out.txt
*.patch
check_chats.go
