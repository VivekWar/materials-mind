# ── Secrets ───────────────────────────────────────────────────────────────
# Environment files must never be committed. The one intentional exception
# (frontend/.env.production) only ever holds a public API URL + public
# OAuth client ID — never real secrets.
.env
.env.*
*.env
*.env.*
!frontend/.env.production
*.pem
*.key
*.crt
*.p12

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/
vendor/

# ── Virtual environments ─────────────────────────────────────────────────
.venv/
venv/
ENV/
data/.venv/

# ── Build outputs ────────────────────────────────────────────────────────
dist/
build/
coverage/

# ── Go artifacts ─────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
backend/main
backend/materialmind

# ── Database dumps / large local datasets ───────────────────────────────
data/*_dump.sql
data/local_dump.sql
data/*.csv

# ── Logs and runtime files ───────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# ── Editor and OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

# ── Python caches and artifacts ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Temporary / scratch files ────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.patch
/hld.html
/lld.html
