# Hugging Face Space Secrets Template
# Do NOT commit your actual keys here. Add these as SECRETS in your Hugging Face Space Settings.

JWT_SECRET=your_production_jwt_secret_here
DATABASE_URL=your_neon_db_connection_string
REDIS_URL=your_upstash_redis_connection_string
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# The URL where your frontend will be hosted (e.g., https://materialsmind.com or https://your-cf-pages-url.pages.dev)
FRONTEND_ORIGIN=https://materialsmind.com
